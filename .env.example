# ==============================================================================
# Enterprise Multi-Tenant RAG & Cognitive Multi-Tier Memory Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT="development"  # development | staging | production
APP_NAME="Enterprise Multi-Tenant RAG Platform"
API_V1_STR="/api/v1"
DEBUG=True

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (PostgreSQL & Storage)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-supabase-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="documents"
# Direct PostgreSQL connection string for asyncpg / SQLAlchemy
DATABASE_URL="postgresql+asyncpg://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# PINECONE VECTOR DATABASE (Serverless v5+)
# ------------------------------------------------------------------------------
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="enterprise-multitenant-rag"
PINECONE_ENVIRONMENT="us-east-1"
EMBEDDING_DIMENSION=768  # 768 / 1536 depending on embedding model

# ------------------------------------------------------------------------------
# UPSTASH REDIS (Working Memory & Cache)
# ------------------------------------------------------------------------------
REDIS_URL="rediss://default:your-upstash-redis-password@your-redis-endpoint.upstash.io:6379"

# ------------------------------------------------------------------------------
# AIVEN APACHE KAFKA (Cloud Managed Event Stream - No Docker Required)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS="your-aiven-kafka-service-uri:port"
KAFKA_SASL_USERNAME="avnadmin"
KAFKA_SASL_PASSWORD="your-aiven-password"
KAFKA_SECURITY_PROTOCOL="SASL_SSL"
KAFKA_SASL_MECHANISM="SCRAM-SHA-256"
KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
KAFKA_TOPIC_INGESTION="doc-ingestion-events"
KAFKA_TOPIC_MEMORY="memory-extraction-events"
KAFKA_TOPIC_DLQ="dead-letter-queue"

# ------------------------------------------------------------------------------
# LLAMAPARSE (Advanced Layout & Table Parsing)
# ------------------------------------------------------------------------------
LLAMA_CLOUD_API_KEY="your-llamaparse-api-key"

# ------------------------------------------------------------------------------
# MULTI-PROVIDER LLM CASCADE (Groq -> NVIDIA -> OpenRouter -> Gemini)
# ------------------------------------------------------------------------------
# 1. Primary: Groq API
GROQ_API_KEY="your-groq-api-key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_DEFAULT_MODEL="llama-3.3-70b-versatile"

# 2. Secondary: NVIDIA NIM API
NVIDIA_API_KEY="your-nvidia-nim-api-key"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_DEFAULT_MODEL="meta/llama-3.3-70b-instruct"

# 3. Fallback: OpenRouter API
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_DEFAULT_MODEL="deepseek/deepseek-r1"

# 4. Fallback: Google Gemini API (OpenAI Compatible Endpoint)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GEMINI_DEFAULT_MODEL="gemini-2.0-flash"

# Embedding Provider Configuration
EMBEDDING_PROVIDER="gemini"  # gemini | openrouter | local
EMBEDDING_MODEL_NAME="text-embedding-004"

# ------------------------------------------------------------------------------
# OBSERVABILITY & TRACING (LangSmith)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY="your-langsmith-api-key"
LANGCHAIN_PROJECT="multitenant-rag-memory"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
